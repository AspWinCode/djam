DATABASE_URL="postgresql://postgres:postgres@localhost:5432/game_game?schema=public"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
AUTH_SESSION_TTL_HOURS="12"
AUTH_MAX_ACTIVE_SESSIONS="5"
AUTH_COOKIE_SAME_SITE="lax"
AUTH_COOKIE_SECURE="false"
AUTH_ALLOW_MISSING_ORIGIN="true"
AUTH_ALLOWED_ORIGINS="http://localhost:3000"
UPLOAD_MAX_BYTES="26214400"
UPLOAD_ALLOWED_IMAGE_MIME_TYPES="image/png,image/jpeg,image/webp,image/gif"
UPLOAD_ALLOWED_VIDEO_MIME_TYPES="video/mp4,video/webm"
UPLOAD_ALLOWED_FILE_MIME_TYPES="application/pdf,text/plain"
STORAGE_PROVIDER="local"
LOCAL_UPLOADS_DIR="uploads"
LOCAL_UPLOADS_PUBLIC_PREFIX="/uploads"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_BASE_URL=""
S3_CREATE_BUCKET_IF_MISSING="false"
MINIO_CONSOLE_URL="http://localhost:9001"
LOG_FILE_PATH=""
LOG_HTTP_REQUESTS="true"
LOG_ERROR_STACKS="false"

# Hide step hints for students/trainers without deleting authored content.
NEXT_PUBLIC_ENABLE_STEP_HINTS="false"
